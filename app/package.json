{
  "name": "app",
  "productName": "RecordShelf",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "build:desktop:web": "RECORDSHELF_LOCAL_DESKTOP=1 vite build --outDir dist/desktop-client",
    "build:desktop": "npm run build:desktop:web && electron-builder --mac dmg --arm64",
    "open:desktop": "open desktop-release/mac-arm64/RecordShelf.app",
    "enrich:covers": "node scripts/enrich-cover-art.mjs",
    "enrich:covers:remote-only": "node scripts/enrich-cover-art.mjs --no-cache-local",
    "enrich:titles": "node scripts/enrich-canonical-titles.mjs",
    "enrich:titles:promote-editions": "node scripts/enrich-canonical-titles.mjs --promote-stored-platform-titles",
    "enrich:types": "node scripts/enrich-release-types.mjs",
    "enrich:dates": "node scripts/enrich-release-dates.mjs",
    "enrich:neodb-urls": "node scripts/enrich-neodb-canonical-urls.mjs",
    "import:neodb": "node scripts/import-neodb-csv.mjs",
    "import:neodb:skip-covers": "node scripts/import-neodb-csv.mjs --skip-covers",
    "repair:neodb-identities": "node scripts/split-merged-neodb-identities.mjs",
    "preview": "vite preview",
    "test": "node --test tests/music.test.mjs tests/artists.test.mjs tests/filters.test.mjs tests/backupMerge.test.mjs tests/shared-state.test.mjs tests/shared-local-state-client.test.mjs",
    "test:build-privacy": "node scripts/verify-build-privacy.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "opencc-js": "^1.4.1",
    "papaparse": "^5.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "^7.18.1",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.jonathanchoiii.recordshelf",
    "productName": "RecordShelf",
    "asar": true,
    "afterPack": "electron/afterPack.mjs",
    "directories": {
      "output": "desktop-release"
    },
    "files": [
      "electron/**/*",
      "shared-state/**/*",
      "scripts/private-covers-http.mjs",
      "scripts/enrich-cover-art.mjs",
      "src/lib/sharedStorageKeys.js",
      "dist/desktop-client/**/*",
      "worker/index.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".private/covers",
        "to": "covers",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "electron/assets/RecordShelf.svg.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "RecordShelf",
      "artifactName": "RecordShelf-${version}-${arch}.${ext}"
    }
  }
}
